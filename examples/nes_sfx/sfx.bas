OPTION ASCII

INCLUDE "nes.bas"

CONST JOY_RIGHT = 1
CONST JOY_LEFT = 2
CONST JOY_DOWN = 4
CONST JOY_UP = 8
CONST JOY_START = 16
CONST JOY_SELECT = 32
CONST JOY_B = 64
CONST JOY_A = 128

DIM j1 AS BYTE FAST
DIM w AS WORD FAST
DIM p AS BYTE FAST
DIM spry(4) AS BYTE @sprite_y
w = 0 : p = 0

CALL LOAD_PALETTE(@palette)

CHARSET 0
HSCROLL 0 : VSCROLL 0

CALL VMEMSET($2000, 32 * 30, 0)		' Clear screen
CALL VMEMSET($23C0, 64, %01010101)	' Set colors

TEXTAT 0, 2, 2, "VOICE 1 DURATION 6 ENVELOPE 8   SWEEP UP 2, 15 TONE 160"
TEXTAT 0, 2, 5, "VOICE 1 DURATION 6 ENVELOPE 5   SWEEP DOWN 4, 2 TONE 260"
TEXTAT 0, 2, 8, "VOICE 3 DURATION 6 TONE 450"
TEXTAT 0, 2, 10, "VOICE 4 DURATION 6 ENVELOPE 15  TONE 255"

CALL SPRITES_ENABLE(1)
CALL BG_ENABLE(1)
CALL VBLANK_NMI_ENABLE(1)

SOUND CLEAR
VOICE 1 ON
VOICE 3 ON
VOICE 4 ON

DO
	CALL WAIT_FRAME()
	IF w = 0 THEN
		j1 = JOY(1)
		IF j1 AND JOY_A THEN
			ON p GOSUB sfx1, sfx2, sfx3, sfx4
		END IF
		IF j1 AND JOY_UP THEN p = p - 1
		IF j1 AND JOY_DOWN THEN p = p + 1
		p = p AND %00000011
		SPRITE 0 SHAPE $E2 AT 8, spry(p)
		IF j1 > 0 THEN w = 25
	END IF
	IF w > 0 THEN w = w - 1
LOOP UNTIL 0

sfx1:
	VOICE 1 DURATION 6 ENVELOPE 8 SWEEP UP 2, 15 TONE 160
	RETURN
sfx2:
	VOICE 1 DURATION 6 ENVELOPE 5 SWEEP DOWN 4, 2 TONE 260
	RETURN
sfx3:
	VOICE 3 DURATION 6 TONE 450
	RETURN
sfx4:
	VOICE 4 DURATION 6 ENVELOPE 15 TONE 255
	RETURN

palette:
DATA AS BYTE $0F, $31, $32, $33, $0F, $35, $36, $37
DATA AS BYTE $0F, $39, $3A, $3B, $0F, $3D, $3E, $0F
DATA AS BYTE $0F, $1C, $15, $14, $0F, $02, $38, $3C
DATA AS BYTE $0F, $1C, $15, $14, $0F, $02, $38, $3C

sprite_y:
DATA AS BYTE 15, 39, 63, 79
